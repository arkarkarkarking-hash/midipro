{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "midipro",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "midipro.kr", "custom_domain": true },
    { "pattern": "www.midipro.kr", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "midipro", "database_id": "4d1eb3aa-835d-4c32-af82-f0f1bf2d4e2d", "migrations_dir": "migrations" }
  ],
  "vars": { "MEDIA_BASE": "https://media.midipro.kr" },
  "build": { "command": "npm run build" },
  "observability": { "enabled": true }
}
