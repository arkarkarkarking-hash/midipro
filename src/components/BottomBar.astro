---
import { getSite } from '../lib/content';
const tel = `tel:${getSite().phone.replaceAll('-', '')}`;
---
<nav class="bottombar" aria-label="빠른 연결">
  <a href={tel} class="bb__call" data-call>전화 상담</a>
  <a href="/location">오시는 길</a>
</nav>

<style>
  .bottombar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--rule-2); background: var(--paper-3); padding-bottom: env(safe-area-inset-bottom); }
  .bottombar a { display: grid; place-items: center; min-height: var(--bottom-h); font-size: 15px; font-weight: 600; }
  .bottombar a + a { border-left: 1px solid var(--rule-2); }
  .bb__call { background: var(--sig); color: var(--sig-ink); }
  @media (min-width: 1024px) { .bottombar { display: none; } }
</style>
