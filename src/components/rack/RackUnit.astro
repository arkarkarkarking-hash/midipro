---
// A ruled panel on the drafting sheet. (Name kept from the earlier rack design; tone/size/seed still accepted.)
interface Props {
  tone?: 'metal' | 'dark';
  size?: 'u1' | 'u2' | 'u3';
  slots?: 0 | 1 | 2;
  seed?: number;
  label?: string;
  as?: 'section' | 'div' | 'header' | 'nav' | 'footer' | 'article';
  class?: string;
  id?: string;
  [key: string]: unknown;
}
const { tone = 'metal', size = 'u2', slots: _slots, seed: _seed, label, as: Tag = 'section', class: cls = '', ...rest } = Astro.props;
---
<Tag class:list={['ru', `ru--${size}`, tone === 'dark' && 'ru--dark', cls]} {...rest}>
  {label && <span class="label ru__label">{label}</span>}
  <div class="ru__in"><slot /></div>
</Tag>
