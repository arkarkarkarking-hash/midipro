---
import RackUnit from './rack/RackUnit.astro';
import Display from './rack/Display.astro';
import Icon from './Icon.astro';
import Waveform from './Waveform.astro';
import type { Track } from '../lib/tracks';
import { formatTime, subtitleOf, toQueueItem } from '../lib/player/queue-items';
interface Props { track: Track; eyebrow: string; listId: string; headingLevel?: 'h1' | 'h2' }
const { track, eyebrow, listId, headingLevel: H = 'h2' } = Astro.props;
---
<RackUnit seed={4}>
  <div class="ft__top"><span class="label">{eyebrow}</span><span class="label mono">{subtitleOf(track)}</span></div>
  <H class="ft__title">{track.title}</H>
  {track.artists.length > 1 && <p class="ft__by">{track.team ? `${track.team} · ` : ''}{track.artists.join(', ')}</p>}
  <Display class="ft__display"><Waveform slug={track.slug} /></Display>
  <div class="knurl ft__knurl" aria-hidden="true"></div>
  <div class="ft__trans">
    <button type="button" class="key key--primary ft__play" data-play-list={listId} data-index="0" aria-label={`${track.title} 재생`}><Icon name="player-play" /></button>
    <span class="ft__time mono">{formatTime(track.duration)}</span>
  </div>
  <script type="application/json" id={`list-${listId}`} set:html={JSON.stringify([toQueueItem(track)])} />
</RackUnit>

<style>
  .ft__top { display: flex; justify-content: space-between; gap: 8px; }
  .ft__title { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; margin-top: 8px; }
  .ft__by { font-size: 13px; color: var(--mu); }
  :global(.ft__display) { margin-top: 12px; }
  .ft__knurl { margin-top: 12px; }
  .ft__trans { display: flex; align-items: center; gap: 8px; margin-top: 12px; }
  .ft__play { width: 44px; height: 34px; }
  .ft__time { margin-left: auto; font-size: 12px; color: var(--mu); background: var(--display); padding: 6px 8px; border-radius: 2px; box-shadow: inset 0 1px 2px #000; }
</style>
