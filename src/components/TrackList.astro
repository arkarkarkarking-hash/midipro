---
import Icon from './Icon.astro';
import type { Track } from '../lib/tracks';
import { formatTime, subtitleOf, toQueueItem } from '../lib/player/queue-items';
interface Props { tracks: Track[]; listId: string }
const { tracks, listId } = Astro.props;
const queue = tracks.map(toQueueItem);
---
<ol class="tl">
  {tracks.map((t, i) => (
    <li data-track-row data-slug={t.slug}>
      <button type="button" class="key tl__play" data-play-list={listId} data-index={i} aria-label={`${t.title} 재생`}>
        <Icon name="player-play" class="i-play" />
        <Icon name="player-pause" class="i-pause" />
      </button>
      <div class="tl__meta">
        <a href={`/music/${t.slug}`} class="tl__title">{t.title}</a>
        <span class="tl__sub"><span class="mono tl__ch">CH{String(i + 1).padStart(2, '0')}</span> · {subtitleOf(t)}</span>
      </div>
      <span class="tl__dur mono">{formatTime(t.duration)}</span>
    </li>
  ))}
</ol>
<script type="application/json" id={`list-${listId}`} set:html={JSON.stringify(queue)} />

<style>
  .tl { list-style: none; }
  li { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 8px 0; border-bottom: 1px solid rgba(0,0,0,.6); box-shadow: 0 1px 0 rgba(255,255,255,.035); }
  li:last-child { border: 0; box-shadow: none; }
  .tl__play { width: 40px; height: 40px; min-height: 40px; padding: 0; }
  .tl__play :global(svg) { width: 16px; height: 16px; }
  .tl__play :global(.i-pause) { display: none; }
  li[data-playing='true'] .tl__play { color: #111; background: linear-gradient(180deg, #f0efeb, #c9c7c1); }
  li[data-playing='true'] .tl__play :global(.i-play) { display: none; }
  li[data-playing='true'] .tl__play :global(.i-pause) { display: block; }
  .tl__meta { min-width: 0; display: flex; flex-direction: column; }
  .tl__title { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tl__title:hover { text-decoration: underline; text-underline-offset: 3px; }
  .tl__sub { font-size: 11px; color: var(--mu); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tl__ch { color: var(--dim); }
  .tl__dur { font-size: 11px; color: var(--dim); }
  li[aria-current='true'] .tl__ch { color: var(--b); }
  li[aria-current='true'] .tl__title { color: #b9b3ff; }
</style>
