---
import { getSite } from '../lib/content';
const site = getSite();
const year = new Date().getFullYear();
const path = Astro.url.pathname.replace(/\.html$/, '');
const showAddress = path !== '/location';
---
<footer class="site-footer">
  <p class="f__name">{site.name}</p>
  {showAddress && <p>{site.address}</p>}
  <p><a class="mono" href={`tel:${site.phone.replaceAll('-', '')}`} data-call>{site.phone}</a>{showAddress && ` · ${site.hours.weekdays} · ${site.hours.saturday}`}</p>
  <ul class="f__links">
    <li><a href={site.links.blog} rel="noopener" target="_blank">네이버 블로그</a></li>
    <li><a href={site.links.instagram} rel="noopener" target="_blank">인스타그램</a></li>
    <li><a href={site.links.youtube} rel="noopener" target="_blank">유튜브</a></li>
    <li><a href="/privacy">개인정보처리방침</a></li>
  </ul>
  <p class="f__copy">© {year} MIDIPRO · SHEET END</p>
</footer>

<style>
  .site-footer { position: relative; z-index: 1; padding: 22px var(--gutter) 28px; font-size: 12px; line-height: 1.75; color: var(--ink-4); background: rgba(13, 13, 15, 0.6); }
  .f__name { color: var(--ink-3); }
  .site-footer a:hover { color: var(--ink); }
  .f__links { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 8px; }
  .f__copy { margin-top: 10px; font: 400 10px var(--mono); letter-spacing: 0.12em; }
</style>
