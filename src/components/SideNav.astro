---
import RackUnit from './rack/RackUnit.astro';
import Keycap from './rack/Keycap.astro';
import { visibleNav, isActive } from '../lib/nav';
import { getSite } from '../lib/content';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const site = getSite();
---
<RackUnit as="nav" tone="dark" size="u3" slots={2} seed={9} class="sidenav" aria-label="주 메뉴">
  <ul>
    {visibleNav().map((n, i) => (
      <li>
        <a href={n.href} aria-current={isActive(n.href, path) ? 'page' : undefined}>
          <span class="label mono">{String(i + 1).padStart(2, '0')}</span>{n.label}
        </a>
      </li>
    ))}
  </ul>
  <div class="sidenav__cta">
    <Keycap variant="primary" href={`tel:${site.phone.replaceAll('-', '')}`} icon="phone" data-call>전화 상담</Keycap>
    <p class="mono">{site.phone}</p>
  </div>
</RackUnit>

<style>
  :global(.sidenav) { display: none; }
  @media (min-width: 1024px) {
    :global(.sidenav) { display: block; position: sticky; top: 12px; align-self: start; margin: 0 0 3px; }
    ul { list-style: none; padding: 6px 0; }
    a { display: flex; gap: 12px; align-items: baseline; padding: 10px 2px; font-size: 15px; border-bottom: 1px solid rgba(0,0,0,.55); box-shadow: 0 1px 0 rgba(255,255,255,.03); }
    a:hover { color: #fff; }
    a[aria-current='page'] { color: #b9b3ff; }
    a[aria-current='page'] .label { color: var(--b); }
    .sidenav__cta { margin-top: 18px; display: grid; gap: 8px; }
    .sidenav__cta p { font-size: 12px; color: var(--mu); text-align: center; }
  }
</style>
