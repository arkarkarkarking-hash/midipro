---
import Icon from '../Icon.astro';
---
<div class="player" transition:persist="player" data-testid="mini-player" hidden>
  <div class="pl__bar">
    <div class="pl__prog" aria-hidden="true"><i data-progress></i></div>
    <div class="pl">
      <span class="pled" aria-hidden="true"></span>
      <button type="button" class="pl__meta" data-open-queue aria-live="polite">
        <span class="pl__title" data-title></span>
        <span class="pl__sub mono" data-sub></span>
      </button>
      <button type="button" class="key pl__btn" data-open-queue aria-label="재생 목록"><Icon name="playlist" /></button>
      <button type="button" class="key pl__btn pl__desk" data-prev aria-label="이전 곡"><Icon name="player-skip-back" /></button>
      <button type="button" class="key pl__btn" data-toggle aria-label="재생/일시정지"><Icon name="player-play" class="i-play" /><Icon name="player-pause" class="i-pause" /></button>
      <button type="button" class="key pl__btn" data-next aria-label="다음 곡"><Icon name="player-skip-forward" /></button>
      <span class="pl__time mono pl__desk" data-time>0:00</span>
    </div>
  </div>
  <audio preload="none" data-audio></audio>
  <dialog class="qsheet" aria-label="재생 목록" data-queue>
    <div class="qsheet__head">
      <span class="label">Queue</span>
      <a href="/music" class="qsheet__all" data-close-queue>음원 전체 보기</a>
      <button type="button" class="key qsheet__x" data-close-queue aria-label="닫기"><Icon name="x" /></button>
    </div>
    <ol class="qsheet__list" data-queue-list></ol>
  </dialog>
</div>

<style>
  .player { position: fixed; left: 0; right: 0; bottom: calc(var(--bottom-h) + env(safe-area-inset-bottom)); z-index: 41; }
  .player[hidden] { display: none; }
  .pl__bar { position: relative; max-width: var(--sheet-max); margin: 0 auto; background: var(--paper-3); border-top: 1px solid var(--rule-2); border-left: 1px solid var(--rule-2); border-right: 1px solid var(--rule-2); padding: 0 var(--gutter); }
  /* progress drawn as a tick ruler */
  .pl__prog { position: absolute; left: 0; right: 0; top: -1px; height: 6px; background: repeating-linear-gradient(90deg, var(--rule-2) 0 1px, transparent 1px 6px); }
  .pl__prog i { display: block; height: 6px; width: 0; background: repeating-linear-gradient(90deg, var(--sig) 0 1px, transparent 1px 6px); border-right: 1px solid var(--sig); }
  .pl { display: flex; align-items: center; gap: 8px; min-height: var(--player-h); }
  .pl__meta { flex: 1; min-width: 0; display: flex; flex-direction: column; text-align: left; }
  .pl__title { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pl__sub { font-size: 10px; color: var(--ink-3); letter-spacing: 0.06em; }
  .pl__btn { min-height: 32px; width: 36px; padding: 0; }
  .pl__btn + .pl__btn { margin-left: -9px; }
  .pl__btn :global(svg) { width: 14px; height: 14px; }
  .pl__time { font-size: 11px; color: var(--ink-3); min-width: 90px; text-align: right; }
  .pl__desk { display: none; }
  .player :global(.i-pause) { display: none; }
  .player [data-toggle] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .player[data-status='playing'] :global(.i-pause), .player[data-status='loading'] :global(.i-pause) { display: block; }
  .player[data-status='playing'] :global(.i-play), .player[data-status='loading'] :global(.i-play) { display: none; }
  .player[data-status='error'] .pl__sub { color: var(--sig); }
  .qsheet { margin: auto auto 0; width: min(560px, 100%); max-height: 70vh; border: 1px solid var(--rule-2); padding: 0; color: var(--ink); background: var(--paper-2); box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.6); }
  .qsheet::backdrop { background: rgba(0, 0, 0, 0.6); }
  .qsheet__head { position: sticky; top: 0; display: flex; align-items: center; gap: 12px; padding: 10px 16px; background: var(--paper-3); border-bottom: 1px solid var(--rule-2); }
  .qsheet__all { margin-left: auto; font: 500 11px var(--mono); letter-spacing: 0.08em; color: var(--sig); }
  .qsheet__x { min-height: 30px; width: 32px; padding: 0; }
  .qsheet__x :global(svg) { width: 14px; height: 14px; }
  .qsheet__list { list-style: none; padding: 0 16px 20px; overflow-y: auto; }
  .qsheet__list :global(button) { width: 100%; display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 10px; align-items: center; text-align: left; padding: 11px 0; border-bottom: 1px solid var(--rule); }
  .qsheet__list :global(.q-n) { font-family: var(--mono); font-size: 10px; color: var(--ink-4); }
  .qsheet__list :global(.q-t) { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .qsheet__list :global(.q-s) { display: block; font-size: 11px; color: var(--ink-3); }
  .qsheet__list :global([aria-current='true'] .q-n), .qsheet__list :global([aria-current='true'] .q-t) { color: var(--sig); }
  @media (min-width: 1024px) {
    .player { bottom: 0; }
    .pl__desk { display: inline-flex; }
  }
</style>

<script>
  import { PlayerController, type QueueItem } from '../../lib/player/controller';
  import { formatTime } from '../../lib/player/queue-items';

  const root = document.querySelector<HTMLElement>('.player')!;
  const audio = root.querySelector<HTMLAudioElement>('[data-audio]')!;
  const session = 'mediaSession' in navigator ? navigator.mediaSession : undefined;
  const controller = new PlayerController(audio, session, session ? (init) => new MediaMetadata(init) : undefined);
  let activeList: string | null = null;

  const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;
  controller.subscribe((s) => {
    if (!s.current) return;
    root.hidden = false;
    root.dataset.status = s.status;
    $('[data-title]').textContent = s.current.title;
    $('[data-sub]').textContent = s.status === 'error' ? '재생할 수 없습니다' : s.current.subtitle;
    const dur = s.duration || s.current.duration;
    const pct = dur ? Math.min(100, (s.position / dur) * 100) : 0;
    $('[data-progress]').style.width = `${pct}%`;
    $('[data-time]').textContent = `${formatTime(s.position)} / ${formatTime(dur)}`;
    markCurrent();
  });

  const sheet = root.querySelector<HTMLDialogElement>('[data-queue]')!;
  const list = root.querySelector<HTMLOListElement>('[data-queue-list]')!;

  function renderQueue() {
    const s = controller.state;
    list.replaceChildren(...controller.queue.map((item, i) => {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.queueItem = '';
      b.dataset.slug = item.slug;
      b.dataset.index = String(i);
      b.setAttribute('aria-current', String(i === s.index));
      const n = document.createElement('span'); n.className = 'q-n'; n.textContent = String(i + 1).padStart(2, '0');
      const t = document.createElement('span'); t.className = 'q-t'; t.textContent = item.title;
      const sub = document.createElement('span'); sub.className = 'q-s'; sub.textContent = item.subtitle;
      t.append(sub);
      b.append(n, t);
      li.append(b);
      return li;
    }));
  }

  root.querySelectorAll('[data-open-queue]').forEach((el) => el.addEventListener('click', () => {
    renderQueue();
    sheet.showModal();
    list.querySelector<HTMLElement>('[aria-current="true"]')?.scrollIntoView({ block: 'center' });
  }));
  root.querySelectorAll('[data-close-queue]').forEach((el) => el.addEventListener('click', () => sheet.close()));
  sheet.addEventListener('click', (e) => {
    if (e.target === sheet) sheet.close();
    const item = (e.target as HTMLElement).closest<HTMLElement>('[data-queue-item]');
    if (!item) return;
    void controller.playList(controller.queue, Number(item.dataset.index));
    renderQueue();
  });

  function markCurrent() {
    const s = controller.state;
    const playing = s.status === 'playing' || s.status === 'loading';
    document.querySelectorAll<HTMLElement>('[data-track-row]').forEach((row) => {
      const on = row.dataset.slug === s.current?.slug;
      row.setAttribute('aria-current', String(on));
      row.dataset.playing = String(on && playing);
    });
    document.querySelectorAll<HTMLElement>('[data-waveform]').forEach((wf) => {
      const on = wf.dataset.waveform === s.current?.slug;
      const dur = s.duration || s.current?.duration || 0;
      wf.style.setProperty('--p', on && dur ? `${(s.position / dur) * 100}%` : '0%');
    });
  }

  $('[data-toggle]').addEventListener('click', () => controller.toggle());
  $('[data-next]').addEventListener('click', () => controller.next());
  $('[data-prev]').addEventListener('click', () => controller.prev());

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-play-list]');
    if (!btn) return;
    const listId = btn.dataset.playList!;
    const index = Number(btn.dataset.index ?? 0);
    const data = document.getElementById(`list-${listId}`)?.textContent;
    if (!data) return;
    const items = JSON.parse(data) as QueueItem[];
    if (activeList === listId && controller.state.index === index && controller.state.current?.slug === items[index]?.slug) {
      controller.toggle();
      return;
    }
    activeList = listId;
    void controller.playList(items, index);
  });

  document.addEventListener('astro:page-load', markCurrent);
</script>
