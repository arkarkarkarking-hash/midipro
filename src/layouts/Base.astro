---
import '../styles/pretendard.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/rack.css';
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Ruler from '../components/Ruler.astro';
import BottomBar from '../components/BottomBar.astro';
import Footer from '../components/Footer.astro';
import Player from '../components/player/Player.astro';
import CallBeacon from '../components/CallBeacon.astro';

interface Props { title: string; description: string; path: string; noindex?: boolean; ogImage?: string; jsonLd?: object[] }
const props = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead {...props} />
    <ClientRouter />
  </head>
  <body>
    <div class="sheet">
      <Header />
      <Ruler />
      <main class="page" id="main"><slot /></main>
      <Footer />
    </div>
    <Player />
    <BottomBar />
    <CallBeacon />
  </body>
</html>
