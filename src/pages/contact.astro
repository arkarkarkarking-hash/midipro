---
import Base from '../layouts/Base.astro';
import RackUnit from '../components/rack/RackUnit.astro';
import Keycap from '../components/rack/Keycap.astro';
import PageHead from '../components/PageHead.astro';
import { getSite } from '../lib/content';
const site = getSite();
const tel = `tel:${site.phone.replaceAll('-', '')}`;
---
<Base title="상담 안내" description="미디프로 입시 상담은 전화로 받습니다. 041-558-3101, 평일 13:00–22:00, 토 09:00–18:00." path="/contact">
  <PageHead code="Call" title="상담 안내">
    <p class="prose">상담은 전화로 받습니다. 학생의 지금 실력과 목표 학교를 듣고, 맞는 과정과 수업 시간을 함께 정합니다.</p>
  </PageHead>
  <RackUnit seed={61}>
    <div class="call">
      <span class="mono call__no">{site.phone}</span>
      <Keycap variant="primary" size="lg" href={tel} icon="phone" data-call>전화 걸기</Keycap>
    </div>
    <p class="muted call__hours">{site.hours.weekdays} · {site.hours.saturday} · {site.hours.closed}</p>
  </RackUnit>
  <RackUnit tone="dark" slots={1} seed={62}>
    <h2 class="prep">상담 전에 준비하면 좋은 것</h2>
    <ul class="list">
      <li>희망 학교와 전공 (정하지 않았어도 괜찮습니다)</li>
      <li>지금까지 배운 것: 미디 프로그램, 피아노, 화성학 경험</li>
      <li>직접 만든 곡이 있다면 파일</li>
    </ul>
  </RackUnit>
</Base>
<style>
  .call { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .call__no { font-size: 22px; }
  .call__hours { font-size: 13px; margin-top: 10px; }
  .prep { font-size: 16px; font-weight: 600; }
  .list { margin-top: 10px; padding-left: 18px; display: grid; gap: 6px; font-size: 14px; color: var(--mu); }
</style>
