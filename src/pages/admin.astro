---
import Base from '../layouts/Base.astro';
import RackUnit from '../components/rack/RackUnit.astro';
import Keycap from '../components/rack/Keycap.astro';
import PageHead from '../components/PageHead.astro';
import { CATEGORY_LABEL, getTracks } from '../lib/tracks';
import '../features/accounts/accounts.css';
const catalog = getTracks().map((t) => ({ slug: t.slug, title: t.title, group: `${CATEGORY_LABEL[t.category]} · ${t.year}` }));
---
<Base title="관리자" description="미디프로 관리자 화면" path="/admin" noindex>
  <div data-admin hidden>
    <PageHead code="Admin" title="관리자" />

    <RackUnit seed={91}>
      <div class="acc-head">
        <h2 class="acc-h">계정</h2>
        <Keycap data-create-toggle icon="plus">계정 만들기</Keycap>
      </div>
      <p class="muted adm__note">계정 추가·비밀번호·비활성화는 원장님 컴퓨터의 계정 메모로 관리합니다. 여기서 바꾼 계정 정보는 메모를 저장할 때 메모 내용으로 돌아갑니다.</p>
      <form class="acc-form acc-form--grid adm__create" data-create-form hidden novalidate>
        <label class="acc-field">아이디 <input class="acc-input" name="loginId" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="영문 소문자·숫자·_ 4~20자" /></label>
        <label class="acc-field">이름 <input class="acc-input" name="name" autocomplete="off" /></label>
        <label class="acc-field">출생연도 <input class="acc-input" name="birthYear" inputmode="numeric" placeholder="예: 2010 (선택)" /></label>
        <label class="acc-field">역할
          <select class="acc-input" name="role">
            <option value="student">수강생</option>
            <option value="teacher">강사</option>
            <option value="admin">관리자</option>
          </select>
        </label>
        <label class="acc-field">비밀번호 <input class="acc-input" name="password" type="text" autocomplete="new-password" placeholder="4~64자" /></label>
        <div class="adm__submit">
          <p class="acc-error" role="alert" data-error></p>
          <Keycap variant="primary" type="submit">만들기</Keycap>
        </div>
      </form>
      <ul class="acc-list" data-users></ul>
    </RackUnit>

    <RackUnit seed={92} data-link-panel hidden>
      <div class="acc-head">
        <h2 class="acc-h">곡 연결 · <span data-link-who></span></h2>
        <Keycap data-close>닫기</Keycap>
      </div>
      <input class="acc-input" type="search" placeholder="곡 검색" aria-label="곡 검색" data-search />
      <div class="acc-scroll" data-checklist></div>
      <div class="acc-head adm__save">
        <p class="acc-ok" role="status" data-status></p>
        <Keycap variant="primary" data-save>저장</Keycap>
      </div>
    </RackUnit>

    <RackUnit seed={93}>
      <div class="acc-head"><h2 class="acc-h">전화 클릭 · 최근 30일</h2></div>
      <div data-calls></div>
    </RackUnit>

    <RackUnit tone="dark" size="u1" seed={94}>
      <div class="acc-actions">
        <Keycap href="/my" data-account-link>마이페이지</Keycap>
        <Keycap data-logout>로그아웃</Keycap>
      </div>
    </RackUnit>

    <dialog class="acc-dialog" data-pw-dialog>
      <form class="acc-form" method="dialog" novalidate>
        <p class="acc-h">비밀번호 재지정</p>
        <p class="muted" data-pw-who></p>
        <label class="acc-field">새 비밀번호 <input class="acc-input" name="password" type="text" autocomplete="new-password" placeholder="4~64자" /></label>
        <p class="acc-error" role="alert" data-error></p>
        <div class="acc-actions">
          <Keycap variant="primary" type="submit">저장</Keycap>
          <Keycap data-cancel>취소</Keycap>
        </div>
      </form>
    </dialog>
    <script type="application/json" id="acc-catalog" set:html={JSON.stringify(catalog)} />
  </div>
</Base>
<style>
  .adm__note { font-size: 12px; margin-bottom: 12px; }
  .adm__create { margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid rgba(0, 0, 0, 0.6); }
  .adm__submit { display: flex; justify-content: space-between; align-items: end; gap: 12px; }
  .adm__save { margin: 12px 0 0; }
  [data-search] { margin-bottom: 4px; }
</style>
<script>
  import '../features/accounts/admin';
</script>
