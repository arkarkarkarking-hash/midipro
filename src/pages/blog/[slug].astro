---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RackUnit from '../../components/rack/RackUnit.astro';
import Keycap from '../../components/rack/Keycap.astro';
import PageHead from '../../components/PageHead.astro';
import PostCard from '../../features/blog/PostCard.astro';
import { CATEGORY_LABEL, dateLabel, postOgImage, relatedPosts, type PostMeta } from '../../features/blog/posts';
import { getPostEntries } from '../../features/blog/collection';
import { getSite } from '../../lib/content';
import { absolute, articleJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const all = await getPostEntries();
  const posts = all.map((p) => p.meta);
  return all.map(({ meta, entry }) => ({ params: { slug: meta.slug }, props: { meta, entry, related: relatedPosts(posts, meta) } }));
}

const { meta, entry, related } = Astro.props as { meta: PostMeta; entry: Parameters<typeof render>[0]; related: PostMeta[] };
const { Content } = await render(entry);
const path = `/blog/${meta.slug}`;
const og = postOgImage(meta);
const site = getSite();
const tel = `tel:${site.phone.replaceAll('-', '')}`;
---
<Base title={meta.title} description={meta.description} path={path} ogImage={og} jsonLd={[articleJsonLd(meta, absolute(path), og)]}>
  <nav class="crumbs label" aria-label="위치"><a href="/">Home</a> / <a href="/blog">블로그</a></nav>
  <PageHead code={CATEGORY_LABEL[meta.category]} title={meta.title}>
    <p class="label mono"><time datetime={dateLabel(meta.date).replaceAll('.', '-')}>{dateLabel(meta.date)}</time></p>
  </PageHead>
  <RackUnit as="article" seed={71}>
    <div class="prose post"><Content /></div>
  </RackUnit>
  <RackUnit tone="dark" seed={72}>
    <div class="call">
      <div>
        <p class="call__lead">상담은 전화로 받습니다.</p>
        <p class="mono call__no">{site.phone}</p>
      </div>
      <Keycap variant="primary" size="lg" href={tel} icon="phone" data-call>전화 상담</Keycap>
    </div>
  </RackUnit>
  {related.length > 0 && (
    <RackUnit slots={1} seed={73}>
      <h2 class="rel">같은 분류 글</h2>
      {related.map((p) => <PostCard post={p} />)}
    </RackUnit>
  )}
</Base>

<style>
  .crumbs { padding: 6px 28px 8px; }
  .crumbs a:hover { color: var(--tx); }
  .post { max-width: 46em; }
  .post :global(h2) { font-size: 18px; font-weight: 700; color: var(--ink); margin: 28px 0 8px; }
  .post :global(h3) { font-size: 16px; font-weight: 600; color: var(--ink); margin: 20px 0 6px; }
  .post :global(p) { margin: 10px 0; }
  .post :global(ul), .post :global(ol) { padding-left: 20px; margin: 10px 0; }
  .post :global(img) { max-width: 100%; height: auto; margin: 14px 0; border: 1px solid var(--rule-2); }
  .post :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .call { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .call__lead { font-size: 15px; }
  .call__no { font-size: 20px; margin-top: 4px; }
  .rel { font-size: 15px; font-weight: 600; }
</style>
