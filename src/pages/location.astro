---
import Base from '../layouts/Base.astro';
import RackUnit from '../components/rack/RackUnit.astro';
import Keycap from '../components/rack/Keycap.astro';
import PageHead from '../components/PageHead.astro';
import { getSite } from '../lib/content';
import { kakaoMapUrl, naverMapUrl } from '../lib/maps';
const site = getSite();
---
<Base title="오시는 길" description="미디프로실용음악학원 위치: 충청남도 천안시 서북구 불당21로 65, 6층. 평일 13:00–22:00, 토 09:00–18:00." path="/location">
  <PageHead code="Location" title="오시는 길" />
  <RackUnit seed={51}>
    <dl class="loc">
      <dt class="label">Addr</dt><dd>{site.address}</dd>
      <dt class="label">Hours</dt><dd>{site.hours.weekdays}<br />{site.hours.saturday}<br /><span class="muted">{site.hours.closed}</span></dd>
      {site.parking && (<><dt class="label">Park</dt><dd>{site.parking}</dd></>)}
      <dt class="label">Tel</dt><dd class="mono">{site.phone}</dd>
    </dl>
  </RackUnit>
  <RackUnit tone="dark" size="u1" seed={52}>
    <div class="maps">
      <Keycap href={naverMapUrl(site.address)} target="_blank" rel="noopener" icon="map-pin">네이버 지도</Keycap>
      <Keycap href={kakaoMapUrl(site.address)} target="_blank" rel="noopener" icon="map-pin">카카오맵</Keycap>
    </div>
  </RackUnit>
</Base>
<style>
  .loc { display: grid; grid-template-columns: 52px 1fr; gap: 10px; font-size: 15px; line-height: 1.6; }
  dt { padding-top: 4px; }
  .maps { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
</style>
